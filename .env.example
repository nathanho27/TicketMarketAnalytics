# Copy this file to .env and fill in your own keys:
#   cp .env.example .env
# .env is listed in .gitignore and must never be committed.

# Ticketmaster Discovery API "Consumer Key"
# https://developer.ticketmaster.com/ -> My Apps
TICKETMASTER_API_KEY=

# Census Data API key (free)
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Last.fm API key (only for scripts/probes/probe_lastfm.py; not used by the pipeline)
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
